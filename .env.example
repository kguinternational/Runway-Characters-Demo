# Required: server-only Runway API key.
# Format: key_ followed by 128 hexadecimal characters.
RUNWAYML_API_SECRET=

# Required Convex development configuration.
# `npx convex dev` normally writes both values to .env.local.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Optional server-only Convex URL override for /api/avatar/rpc.
# If blank, the route falls back to NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=

# Optional avatar overrides. Defaults to the original music-superstar preset.
# RUNWAY_AVATAR_TYPE accepts: preset, runway-preset, or custom.
RUNWAY_AVATAR_ID=
RUNWAY_AVATAR_TYPE=
NEXT_PUBLIC_RUNWAY_AVATAR_ID=

# Optional alternate Runway API base URL. Leave blank for the SDK default.
RUNWAYML_BASE_URL=

# Deployment/CI only. Store this as a Vercel secret, not in source control.
CONVEX_DEPLOY_KEY=
